<?xml version="1.0" encoding="utf-8"?>
<!-- Single cache property card: large bold value on top, small label below -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:layout_marginLeft="3dp"
    android:layout_marginRight="3dp"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/property_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="@dimen/textSize_detailsPrimaryLarge"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        tools:text="传统藏点" />

    <RatingBar
        android:id="@+id/property_stars"
        style="@style/cacheRatingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:visibility="gone"
        tools:rating="2"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/property_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textSize="@dimen/textSize_detailsSecondary"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="类型" />

</LinearLayout>
